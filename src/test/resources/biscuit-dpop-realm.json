            "biscuit.role.rights": "[{\"role\": \"analyst\", \"tool\": \"list_tables\", \"operation\": \"read\"}]",
            "biscuit.budget.cap": "7",
            "biscuit.ttl": "60",
            "biscuit.derived.facts": "[{\"key\":\"agent_id\",\"value\":\"agent_id\"}]",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
